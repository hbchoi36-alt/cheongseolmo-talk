# 이 파일은 예시입니다. 복사해서 .env를 만들고 값을 채우세요 (.env는 저장소에 올라가지 않습니다).

# 필수: OpenAI API 키 (서버에서만 사용, NEXT_PUBLIC_ 접두사를 붙이지 마세요)
OPENAI_API_KEY=

# 필수(배포 환경): 운영자 비밀번호. AI 분석을 시작할 때 입력합니다. 길게 정하세요.
# 로컬 개발에서 비워 두면 비밀번호 없이 쓸 수 있지만, 배포 환경에서는 비어 있으면 분석이 막힙니다.
OPERATOR_PASSWORD=

# 선택: 사용할 모델 이름. 비워 두면 코드의 기본값(gpt-6.1-sol)을 씁니다.
# OPENAI_MODEL=
